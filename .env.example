# Names only. The real file is ../u-hackathon-2026-private/.env, outside the repo. Never commit values.
APP_ENV=
ANTHROPIC_API_KEY=
# default claude-sonnet-5-5
ANTHROPIC_MODEL_CONTENT=
# default claude-haiku-5-5
ANTHROPIC_MODEL_RUNTIME=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# optional
TOKENOMIST_API_KEY=
# default 300
DAILY_AI_CAP=
# Penny's voice through api/tts.php (docs/DECISIONS.md #60). Model default eleven_flash_v2_5 (lowest latency).
ELEVENLABS_TTS_MODEL=
# ElevenLabs premade voice ids. Defaults: Penny = Bella hpp4J3VqNfWAUOO0d1Us, female = Matilda XrExE9yKIg1WjnnlVkGX,
# male = Chris iP95p4xoKVk53GoZ742B, neutral = River SAz9YHcvj6GT2YYXdXww. Premade only, never a clone.
ELEVENLABS_VOICE_PENNY=
ELEVENLABS_VOICE_FEMALE=
ELEVENLABS_VOICE_MALE=
ELEVENLABS_VOICE_NEUTRAL=
# Characters sent to ElevenLabs per Bangkok day (cached clips are free). Default 20000
TTS_DAILY_CHAR_CAP=
# Signs the tts token that comes with each Penny answer. Optional: if empty, a random secret is kept in the private folder.
TTS_HMAC_SECRET=
# Judge demo Arena accounts (adult, deleted after 24 h); default 1, set 0 to switch off after judging
DEMO_ENABLED=
# optional: 0 forces the v1 Arena even when the database has the v2 schema
ARENA_V2=
# Arena and accounts database (MariaDB)
DB_HOST=
DB_PORT=
DB_NAME=
DB_USER=
DB_PASS=
# 1 opens the Arena
ARENA_ENABLED=
# Judge demo Arena accounts per IP per hour (judges share the venue Wi-Fi). Default 60
DEMO_PER_HOUR=
